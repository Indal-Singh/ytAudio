# App listen port (dev + start + Docker)
PORT=3000

# Optional bind host (Docker usually needs 0.0.0.0)
# HOSTNAME=0.0.0.0

# Full path or command name for yt-dlp
# Examples:
#   YTDLP_PATH=yt-dlp
#   YTDLP_PATH=/snap/bin/yt-dlp
YTDLP_PATH=yt-dlp

# Full path or command name for ffmpeg
# Examples:
#   FFMPEG_PATH=ffmpeg
#   FFMPEG_PATH=/usr/bin/ffmpeg
#   FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=ffmpeg
