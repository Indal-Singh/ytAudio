# ==========================================================
# YTaudio Server Configuration
# ==========================================================

# Public site URL used for canonical links, sitemaps, OpenGraph cards and crawler SEO
NEXT_PUBLIC_SITE_URL=https://yta.indalsingh.dev

# App listen port (dev + start + Docker)
PORT=3000

# Optional bind host (Docker usually needs 0.0.0.0)
HOSTNAME=0.0.0.0

# Full path or command name for yt-dlp
# Examples:
#   Windows: C:\Users\<Username>\AppData\Local\Programs\Python\Python313\Scripts\yt-dlp.exe
#   Linux/Docker: yt-dlp or /usr/local/bin/yt-dlp
YTDLP_PATH=yt-dlp

# Full path or command name for ffmpeg
# Examples:
#   Windows: C:\ffmpeg\bin\ffmpeg.exe or ffmpeg
#   Linux/Docker: ffmpeg or /usr/bin/ffmpeg
FFMPEG_PATH=ffmpeg

# Optional: YouTube Authentication / Cookies (to prevent "Sign in to confirm you're not a bot")
# Export cookies from your browser via 'Get cookies.txt LOCALLY' extension
# Examples:
#   YTDLP_COOKIES_PATH=./cookies.txt
#   YTDLP_COOKIES_BROWSER=chrome
YTDLP_COOKIES_PATH=
YTDLP_COOKIES_BROWSER=
